# ─────────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Nunca comite .env.local.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# URL do projeto (ex: https://xxxx.supabase.co)
SUPABASE_URL=
# Chave pública (usada pelo front-end / leitura)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service-role (SÓ no servidor / scripts de ingestão — nunca no front-end)
SUPABASE_SERVICE_ROLE_KEY=

# ── Extração por IA (Anthropic) ───────────────────────────────
ANTHROPIC_API_KEY=
# Modelo usado para extrair os campos do anúncio.
# Padrão: claude-opus-5 (máxima qualidade).
# Para ALTO VOLUME, troque por um modelo mais barato, ex: claude-haiku-4-5.
EXTRACTION_MODEL=claude-opus-5

# ── Jina Reader (coleta) ──────────────────────────────────────
# Opcional: uma chave da Jina (https://jina.ai) aumenta o rate limit do r.jina.ai.
# Sem chave, funciona no limite gratuito.
JINA_API_KEY=

# ── Painel de administração ───────────────────────────────────
# Senha que protege as rotas de coleta (/api/discover, /api/collect).
# Defina um valor forte e use o mesmo no campo "senha" do painel (/admin).
# Sem este valor, as rotas de coleta ficam bloqueadas (fail-closed).
ADMIN_TOKEN=

# ── Google (descoberta de imobiliárias + geocoding) ───────────
# Chave da Google Maps Platform (Places API + Geocoding API habilitados).
GOOGLE_MAPS_API_KEY=
